{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "VITE_API_URL=https://thanveerahammed-api.onrender.com npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/rss.xml",
      "destination": "https://thanveerahammed-api.onrender.com/rss.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://thanveerahammed-api.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://thanveerahammed-api.onrender.com/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
