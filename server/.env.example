# --- Server ---
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (the client dev + prod URLs).
CLIENT_URL=http://localhost:5173

# Public URL of the deployed website (not this API) — used for absolute URLs in
# sitemap.xml / rss.xml and added to the CORS allow-list. No trailing slash.
PUBLIC_SITE_URL=https://thanveerahammed.in

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# --- Contact form (Resend) ---
# Leave RESEND_API_KEY / CONTACT_TO_EMAIL blank to disable sending — submissions are still stored in MongoDB,
# and the form shows a "not fully configured" message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: once you've verified a domain in Resend, set a sender on that domain —
# the shared onboarding@resend.dev sandbox address is rate-limited and spam-flagged.
# CONTACT_FROM_EMAIL="Portfolio Contact Form <contact@yourdomain.com>"
